# Application Environment
ENV=staging

# Base URLs
BASE_URL=https://www.saucedemo.com
API_BASE_URL=https://api.saucedemo.com

# Credentials (NEVER commit real credentials!)
SAUCE_DEMO_USERNAME=standard_user
SAUCE_DEMO_PASSWORD=secret_sauce

# Browser & Device
BROWSER=chromium
HEADLESS=true

# Timeouts (milliseconds)
TIMEOUT=30000
NAVIGATION_TIMEOUT=30000

# Logging
LOG_LEVEL=info
DEBUG=false

# CI/CD
CI=false
