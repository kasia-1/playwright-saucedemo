# Application Environment
ENV=staging

# Base URLs
BASE_URL=https://www.saucedemo.com
API_BASE_URL=https://api.saucedemo.com

# Credentials (Public SauceDemo test accounts - safe for portfolio/demo)
# These are demo accounts provided by SauceDemo for testing
SAUCE_DEMO_USERNAME=standard_user
SAUCE_DEMO_PASSWORD=secret_sauce
SAUCE_DEMO_LOCKED_OUT_USER=locked_out_user
SAUCE_DEMO_PROBLEM_USER=problem_user
SAUCE_DEMO_PERFORMANCE_GLITCH_USER=performance_glitch_user
SAUCE_DEMO_ERROR_USER=error_user
SAUCE_DEMO_VISUAL_USER=visual_user

# Browser & Device
BROWSER=chromium
HEADLESS=true

# Timeouts (milliseconds)
TIMEOUT=30000
NAVIGATION_TIMEOUT=30000

# Logging
LOG_LEVEL=info
DEBUG=false

# CI/CD
CI=false
